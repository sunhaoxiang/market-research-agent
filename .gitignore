.schema-cache/

# ── 编辑器 / 系统
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── 日志与临时
*.log
npm-debug.log*
pnpm-debug.log*
.tmp/
coverage/
playwright-report/
test-results/

# ── Eval 结果（本地跑的结果不入库，归档结果手动提交）
evals/results/local/
