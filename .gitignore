# ── Secrets（严禁入库，见 DEVELOPMENT_PLAN.md §17.1）
.env
.env.*
!.env.example

# ── 数据与数据库
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Node
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
*.tsbuildinfo
.turbo/

# ── Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.basedpyright/
*.egg-info/
.coverage
htmlcov/

