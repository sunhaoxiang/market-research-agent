# ============================================================================
# market-research-agent 环境变量
#
# 用法：cp .env.example .env.local  然后填入真实值
# 说明：见 docs/DEVELOPMENT_PLAN.md §17
#
# 安全规则：
#   1. 本文件只放占位值，真实 key 只写进 .env.local（已 gitignore）
#   2. 严禁使用 NEXT_PUBLIC_ 前缀承载任何 secret（会打进浏览器 bundle）
#   3. 所有外部 API 请求由 Python 服务发起，浏览器不直连第三方
# ============================================================================

# ─── LLM Providers ──────────────────────────────────────────────────────────
# 开发期主力（见 §9.7）。DeepSeek 分时计价：北京时间 09-12 与 14-18 为高峰，其余减半
DEEPSEEK_API_KEY=

# 第二 provider：用于验证多模型抽象层，且中文写作可与 DeepSeek 对比
ZHIPU_API_KEY=

# ⚠️ 开发期这个 key 只用于 SDK tracing 上传（免费，不消耗 token），不跑模型。
#    没有它 tracing 必须关闭，自建埋点就成了唯一调试面（见 §9.6）
OPENAI_API_KEY=

# 备选 provider：留空即可，UI 中会显示为禁用并说明原因
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Base URL 覆盖（一般无需修改；自建代理或兼容端点时使用）
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ─── 数据源 ─────────────────────────────────────────────────────────────────
# 全部为免费档，申请指引见 §17.2。Phase 0/1 不需要，Phase 2 起逐步需要
TAVILY_API_KEY=
# CoinGecko Demo key，可空（走公共限流）。有 key 时约 30 次/分、1 万次/月
COINGECKO_API_KEY=
FMP_API_KEY=
# SEC EDGAR 不需要 key，但强制要求可识别的 User-Agent（填你的真实邮箱）
SEC_USER_AGENT=market-research-agent your@email.com

# ─── 服务 ───────────────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://127.0.0.1:8000
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8000
# 内网调用校验用的共享随机串。生成：openssl rand -hex 32
INTERNAL_API_TOKEN=

# ─── 数据库 ─────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/app.db
AGENT_CACHE_DB=./data/provider-cache.db

# ─── 模型默认值（见 §9.5 / §9.7）───────────────────────────────────────────
# 开发期配置。上线切 OpenAI 时只改这五行，不动代码：
#   PLANNER=openai:gpt-5.6-sol  BALANCED=openai:gpt-5.6-terra
#   FAST=openai:gpt-5.6-luna    WRITING=openai:gpt-5.6-sol
DEFAULT_MODEL_ID=deepseek:deepseek-v4-pro
MODEL_ROLE_PLANNER=deepseek:deepseek-v4-pro
MODEL_ROLE_BALANCED=deepseek:deepseek-v4-pro
MODEL_ROLE_FAST=deepseek:deepseek-v4-flash
MODEL_ROLE_WRITING=deepseek:deepseek-v4-pro

# ─── 执行上限（见 §7.2，防止成本与延迟失控）──────────────────────────────────
MAX_TASKS_PER_PLAN=6
MAX_PARALLEL_TASKS=4
MAX_TOOL_CALLS_PER_AGENT=12
MAX_SUPPLEMENT_ROUNDS=1
TASK_TIMEOUT_S=120
TOTAL_TIMEOUT_S=420
# 单次研究成本上限（USD），超出发 WARNING 事件。
# 开发期 DeepSeek 配置约 $0.10/次，上线 OpenAI 配置约 $0.50/次（§9.7）
MAX_SESSION_COST_USD=1.0

# ─── 可观察性 ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
# false = 开启 SDK tracing（需要 OPENAI_API_KEY，会上传 prompt/响应到 OpenAI）
# 无 OPENAI_API_KEY 时必须设为 true，否则每次运行都会尝试上传 trace 并报错（§9.6）
OPENAI_AGENTS_DISABLE_TRACING=false
